# Copy to .env, then generate real secrets before running -- the defaults in
# docker-compose.yml are throwaway values, fine for a one-off local check,
# NOT fine if you tunnel this out (cloudflared) for anyone else to reach.
#   openssl rand -hex 32   # for ENCRYPTION_KEY
#   openssl rand -base64 32  # for SALT / NEXTAUTH_SECRET / *_PASSWORD / REDIS_AUTH

SALT=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=
REDIS_AUTH=

# Auto-provision one org/project/user/API-key pair on first boot so you don't
# have to sign up through the web UI (see LANGFUSE_INIT_* in docker-compose.yml).
LANGFUSE_INIT_ORG_ID=kaggle-agent-org
LANGFUSE_INIT_ORG_NAME=kaggle-agent
LANGFUSE_INIT_PROJECT_ID=kaggle-agent-project
LANGFUSE_INIT_PROJECT_NAME=kaggle-agent
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
